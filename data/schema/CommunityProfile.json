{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/CSLee2291/taipei-community-research/blob/main/data/schema/CommunityProfile.json",
  "title": "Taipei Community Research Profile",
  "description": "Schema for a consolidated, versioned view of one community and its related research records. CSV tables remain the normalized storage interface.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "generated_at",
    "community",
    "activities",
    "sdg_alignments",
    "awards",
    "funding"
  ],
  "properties": {
    "profile_version": {
      "type": "string",
      "description": "Semantic version of the assembled profile.",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when the profile was assembled."
    },
    "community": {
      "$ref": "#/$defs/Community"
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CommunityActivity"
      }
    },
    "sdg_alignments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CommunitySDGs"
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CommunityAwards"
      }
    },
    "funding": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CommunityFunding"
      }
    }
  },
  "$defs": {
    "Community": {
      "type": "object",
      "description": "Master record for one Taipei community and its associated development organization.",
      "additionalProperties": false,
      "required": [
        "community_id",
        "community_name_zh",
        "record_status",
        "data_quality_flag",
        "created_at",
        "updated_at",
        "schema_version"
      ],
      "properties": {
        "community_id": {
          "type": "string",
          "description": "Stable project identifier for the community.",
          "pattern": "^COM-[A-Z0-9][A-Z0-9-]{2,63}$"
        },
        "community_name_zh": {
          "type": "string",
          "description": "Authoritative Traditional Chinese community name."
        },
        "community_name_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English community name, if an approved translation exists."
        },
        "association_name_zh": {
          "type": [
            "string",
            "null"
          ],
          "description": "Registered Traditional Chinese name of the community development association."
        },
        "association_name_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English association name, if an approved translation exists."
        },
        "district_code": {
          "type": [
            "string",
            "null"
          ],
          "description": "Stable district code stored as text to preserve leading zeroes."
        },
        "district_name_zh": {
          "type": [
            "string",
            "null"
          ],
          "description": "Traditional Chinese district name."
        },
        "district_name_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English district name."
        },
        "administrative_area_code": {
          "type": [
            "string",
            "null"
          ],
          "description": "Official administrative-area identifier, stored as text."
        },
        "address_zh": {
          "type": [
            "string",
            "null"
          ],
          "description": "Public organizational address in Traditional Chinese."
        },
        "address_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English rendering of the public organizational address."
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90,
          "description": "WGS84 latitude in decimal degrees."
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180,
          "description": "WGS84 longitude in decimal degrees."
        },
        "established_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Known establishment date; use the most precise supported date and explain partial dates in notes."
        },
        "registration_number": {
          "type": [
            "string",
            "null"
          ],
          "description": "Public organization registration identifier."
        },
        "organization_status": {
          "type": "string",
          "description": "Observed organization status.",
          "enum": [
            "active",
            "inactive",
            "dissolved",
            "unknown"
          ]
        },
        "official_website_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Official public website or profile URL."
        },
        "contact_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Public contact page URL; do not store private contact details."
        },
        "description_zh": {
          "type": [
            "string",
            "null"
          ],
          "description": "Factual Traditional Chinese community description."
        },
        "description_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English community description."
        },
        "first_observed_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Earliest date the project observed this community record."
        },
        "last_verified_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Most recent date the record was verified against evidence."
        },
        "source_title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable title of the principal source."
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Canonical URL for the principal supporting source."
        },
        "source_accessed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date on which the source was accessed."
        },
        "provenance_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "Concise note describing source lineage, transformation, or conflicts."
        },
        "record_status": {
          "type": "string",
          "description": "Lifecycle state of the research record.",
          "enum": [
            "draft",
            "verified",
            "superseded",
            "withdrawn"
          ]
        },
        "data_quality_flag": {
          "type": "string",
          "description": "Highest-priority quality flag for the record.",
          "enum": [
            "none",
            "incomplete",
            "conflicting",
            "estimated",
            "review_required"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp when the record was first created."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp when the record was last changed."
        },
        "schema_version": {
          "type": "string",
          "description": "Schema version used for this record.",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "description": "Non-sensitive research notes not represented by another field."
        }
      }
    },
    "CommunityActivity": {
      "type": "object",
      "description": "One program, event, service, or recurring activity associated with a community.",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "community_id",
        "activity_title_zh",
        "activity_type",
        "record_status",
        "data_quality_flag",
        "created_at",
        "updated_at",
        "schema_version"
      ],
      "properties": {
        "activity_id": {
          "type": "string",
          "description": "Stable project identifier for the activity.",
          "pattern": "^ACT-[A-Z0-9][A-Z0-9-]{2,63}$"
        },
        "community_id": {
          "type": "string",
          "description": "Foreign key to Community.community_id.",
          "pattern": "^COM-[A-Z0-9][A-Z0-9-]{2,63}$"
        },
        "activity_title_zh": {
          "type": "string",
          "description": "Traditional Chinese activity title."
        },
        "activity_title_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English activity title."
        },
        "activity_type": {
          "type": "string",
          "description": "Controlled high-level activity category.",
          "enum": [
            "education",
            "environment",
            "health",
            "culture",
            "welfare",
            "safety",
            "economic_development",
            "governance",
            "recreation",
            "other"
          ]
        },
        "description_zh": {
          "type": [
            "string",
            "null"
          ],
          "description": "Factual Traditional Chinese description of the activity."
        },
        "description_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English description of the activity."
        },
        "start_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Activity start date."
        },
        "end_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Activity end date; equal to start_date for a one-day activity."
        },
        "recurrence": {
          "type": "string",
          "description": "Recurrence pattern.",
          "enum": [
            "one_time",
            "daily",
            "weekly",
            "monthly",
            "annual",
            "irregular",
            "ongoing",
            "unknown"
          ]
        },
        "venue_name_zh": {
          "type": [
            "string",
            "null"
          ],
          "description": "Traditional Chinese venue name."
        },
        "venue_name_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English venue name."
        },
        "district_code": {
          "type": [
            "string",
            "null"
          ],
          "description": "District code for the activity location."
        },
        "latitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -90,
          "maximum": 90,
          "description": "WGS84 activity latitude in decimal degrees."
        },
        "longitude": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -180,
          "maximum": 180,
          "description": "WGS84 activity longitude in decimal degrees."
        },
        "target_audience": {
          "type": [
            "string",
            "null"
          ],
          "description": "Plain-language audience description; avoid personal data."
        },
        "participant_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Reported or verified participant count."
        },
        "lead_organizer_zh": {
          "type": [
            "string",
            "null"
          ],
          "description": "Traditional Chinese name of the lead organization."
        },
        "lead_organizer_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English name of the lead organization."
        },
        "partner_summary": {
          "type": [
            "string",
            "null"
          ],
          "description": "Concise summary of partner organizations; use a future junction table for analytical partner data."
        },
        "activity_status": {
          "type": "string",
          "description": "Observed activity status.",
          "enum": [
            "planned",
            "active",
            "completed",
            "cancelled",
            "unknown"
          ]
        },
        "source_title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable title of the principal source."
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Canonical URL for the principal supporting source."
        },
        "source_accessed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date on which the source was accessed."
        },
        "provenance_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "Concise note describing source lineage, transformation, or conflicts."
        },
        "record_status": {
          "type": "string",
          "description": "Lifecycle state of the research record.",
          "enum": [
            "draft",
            "verified",
            "superseded",
            "withdrawn"
          ]
        },
        "data_quality_flag": {
          "type": "string",
          "description": "Highest-priority quality flag for the record.",
          "enum": [
            "none",
            "incomplete",
            "conflicting",
            "estimated",
            "review_required"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp when the record was first created."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp when the record was last changed."
        },
        "schema_version": {
          "type": "string",
          "description": "Schema version used for this record.",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "description": "Non-sensitive research notes not represented by another field."
        }
      }
    },
    "CommunitySDGs": {
      "type": "object",
      "description": "Evidence-backed alignment between a community or activity and a UN Sustainable Development Goal.",
      "additionalProperties": false,
      "required": [
        "community_sdg_id",
        "community_id",
        "sdg_goal",
        "alignment_type",
        "evidence_zh",
        "record_status",
        "data_quality_flag",
        "created_at",
        "updated_at",
        "schema_version"
      ],
      "properties": {
        "community_sdg_id": {
          "type": "string",
          "description": "Stable project identifier for the SDG assessment.",
          "pattern": "^SDG-[A-Z0-9][A-Z0-9-]{2,63}$"
        },
        "community_id": {
          "type": "string",
          "description": "Foreign key to Community.community_id.",
          "pattern": "^COM-[A-Z0-9][A-Z0-9-]{2,63}$"
        },
        "activity_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^ACT-[A-Z0-9][A-Z0-9-]{2,63}$",
          "description": "Optional foreign key to CommunityActivity.activity_id when the assessment concerns a specific activity."
        },
        "sdg_goal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17,
          "description": "UN Sustainable Development Goal number."
        },
        "sdg_target": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional official SDG target code, such as 11.3.",
          "pattern": "^[0-9]{1,2}\\.[0-9A-Za-z]+$"
        },
        "alignment_type": {
          "type": "string",
          "description": "Relationship supported by the evidence.",
          "enum": [
            "direct",
            "enabling",
            "contextual",
            "negative_impact",
            "uncertain"
          ]
        },
        "evidence_zh": {
          "type": "string",
          "description": "Traditional Chinese evidence statement supporting the assessment."
        },
        "evidence_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English evidence statement supporting the assessment."
        },
        "evidence_start_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Start of the period covered by the evidence."
        },
        "evidence_end_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "End of the period covered by the evidence."
        },
        "confidence_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Assessment confidence from 0 to 1."
        },
        "assessment_method": {
          "type": [
            "string",
            "null"
          ],
          "description": "Method or rubric used to assign the SDG alignment."
        },
        "assessment_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date the alignment was assessed."
        },
        "assessor_role": {
          "type": [
            "string",
            "null"
          ],
          "description": "Team or role responsible for the assessment; avoid unnecessary personal names."
        },
        "source_title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable title of the principal source."
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Canonical URL for the principal supporting source."
        },
        "source_accessed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date on which the source was accessed."
        },
        "provenance_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "Concise note describing source lineage, transformation, or conflicts."
        },
        "record_status": {
          "type": "string",
          "description": "Lifecycle state of the research record.",
          "enum": [
            "draft",
            "verified",
            "superseded",
            "withdrawn"
          ]
        },
        "data_quality_flag": {
          "type": "string",
          "description": "Highest-priority quality flag for the record.",
          "enum": [
            "none",
            "incomplete",
            "conflicting",
            "estimated",
            "review_required"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp when the record was first created."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp when the record was last changed."
        },
        "schema_version": {
          "type": "string",
          "description": "Schema version used for this record.",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "description": "Non-sensitive research notes not represented by another field."
        }
      }
    },
    "CommunityAwards": {
      "type": "object",
      "description": "One public award, recognition, or competition result associated with a community or activity.",
      "additionalProperties": false,
      "required": [
        "award_id",
        "community_id",
        "award_name_zh",
        "record_status",
        "data_quality_flag",
        "created_at",
        "updated_at",
        "schema_version"
      ],
      "properties": {
        "award_id": {
          "type": "string",
          "description": "Stable project identifier for the award record.",
          "pattern": "^AWD-[A-Z0-9][A-Z0-9-]{2,63}$"
        },
        "community_id": {
          "type": "string",
          "description": "Foreign key to Community.community_id.",
          "pattern": "^COM-[A-Z0-9][A-Z0-9-]{2,63}$"
        },
        "activity_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^ACT-[A-Z0-9][A-Z0-9-]{2,63}$",
          "description": "Optional foreign key to CommunityActivity.activity_id."
        },
        "award_name_zh": {
          "type": "string",
          "description": "Traditional Chinese award or recognition name."
        },
        "award_name_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English award or recognition name."
        },
        "awarding_body_zh": {
          "type": [
            "string",
            "null"
          ],
          "description": "Traditional Chinese name of the awarding body."
        },
        "awarding_body_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English name of the awarding body."
        },
        "award_level": {
          "type": "string",
          "description": "Geographic or institutional award level.",
          "enum": [
            "community",
            "district",
            "municipal",
            "national",
            "international",
            "other",
            "unknown"
          ]
        },
        "award_category_zh": {
          "type": [
            "string",
            "null"
          ],
          "description": "Traditional Chinese award category."
        },
        "award_category_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English award category."
        },
        "award_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Award announcement or presentation date."
        },
        "award_year": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2100,
          "description": "Award year when an exact date is unavailable."
        },
        "rank_or_result": {
          "type": [
            "string",
            "null"
          ],
          "description": "Published rank, tier, distinction, or result."
        },
        "recipient_type": {
          "type": "string",
          "description": "Type of named recipient.",
          "enum": [
            "community",
            "association",
            "activity",
            "other",
            "unknown"
          ]
        },
        "recipient_name_zh": {
          "type": [
            "string",
            "null"
          ],
          "description": "Traditional Chinese public recipient name."
        },
        "recipient_name_en": {
          "type": [
            "string",
            "null"
          ],
          "description": "English public recipient name."
        },
        "certificate_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Public award announcement or certificate URL."
        },
        "source_title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Human-readable title of the principal source."
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "description": "Canonical URL for the principal supporting source."
        },
        "source_accessed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "Date on which the source was accessed."
        },
        "provenance_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "Concise note describing source lineage, transformation, or conflicts."
        },
        "record_status": {
          "type": "string",
          "description": "Lifecycle state of the research record.",
          "enum": [
            "draft",
            "verified",
            "superseded",
            "withdrawn"
          ]
        },
        "data_quality_flag": {
          "type": "string",
          "description": "Highest-priority quality flag for the record.",
          "enum": [
            "none",
            "incomplete",
            "conflicting",
            "estimated",
            "review_required"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp when the record was first created."
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "UTC timestamp when the record was last changed."
        },
        "schema_version": {
          "type": "string",
          "description": "Schema version used for this record.",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "description": "Non-sensitive research notes not represented by another field."
        }
      }
    },
    "CommunityFunding": {
      "type": "object",
      "description": "One funding application, award, grant, subsidy, donation, or in-kind support record.",
      "additionalProperties": false,
      "required": [
        "funding_id",
        "community_id",
        "fiscal_year",
        "program_name_zh",
